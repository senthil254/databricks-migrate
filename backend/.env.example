# Copy to backend/.env and fill in. backend/.env is git-ignored and must stay that way —
# it holds live credentials for three systems.
#
#     cp backend/.env.example backend/.env
#     chmod 600 backend/.env

# ---------------------------------------------------------------- Databricks (target)
# Two ways to authenticate. Pick one.
#
# A) Named CLI profile — normal on a developer machine.
#      databricks auth login --host https://<workspace>.cloud.databricks.com --profile my-profile
#    OAuth tokens are stored in the OS keyring and refresh themselves.
DATABRICKS_PROFILE=my-profile

# B) Environment auth — for containers, Codespaces and CI, where no ~/.databrickscfg exists.
#    Set DATABRICKS_PROFILE to EMPTY (that is meaningful, not an oversight) and supply:
# DATABRICKS_PROFILE=
# DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=<personal access token>
#    In production prefer a service principal, which is not tied to one person's account:
# DATABRICKS_CLIENT_ID=<service principal id>
# DATABRICKS_CLIENT_SECRET=<service principal secret>

# The SQL Warehouse everything runs against.
# HTTP path: SQL Warehouses -> your warehouse -> Connection details.
DATABRICKS_WAREHOUSE_HOSTNAME=<workspace>.cloud.databricks.com
DATABRICKS_WAREHOUSE_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>

# Where migrated objects are created.
DATABRICKS_TARGET_CATALOG=lakebridge_demo
DATABRICKS_TARGET_SCHEMA=g3_migrations

# ---------------------------------------------------------------- CORS
# Comma-separated. Defaults to the two localhost:5173 origins when unset.
# "*" is refused on purpose: this API performs real writes and has no auth model.
# ALLOWED_ORIGINS=http://localhost:5173,https://<your-forwarded-host>

# ---------------------------------------------------------------- Redshift (source)
REDSHIFT_HOST=<cluster>.<region>.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=dev
REDSHIFT_USER=<user>
REDSHIFT_PASSWORD=<password>
REDSHIFT_CLUSTER_ID=<cluster-id>

# ---------------------------------------------------------------- Starburst / Trino (source)
STARBURST_HOST=<cluster>.trino.galaxy.starburst.io
STARBURST_PORT=443
STARBURST_CATALOG=<catalog>
STARBURST_SCHEMA=<schema>
STARBURST_USER=<user>
STARBURST_PASSWORD=<password>
STARBURST_CLIENT_ID=<oauth client id>
STARBURST_CLIENT_SECRET=<oauth client secret>
STARBURST_TOKEN_URL=<oauth token url>

# ---------------------------------------------------------------- Optional: natural-language chat
# Off by default. With LLM_ENABLED unset or no key, no network call is made and behaviour is
# byte-identical to the deterministic parser. The model only ever selects one action from a
# closed set — it never writes SQL or DDL.
LLM_ENABLED=false
LLM_PROVIDER=anthropic          # anthropic | openai | deepseek
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=20
